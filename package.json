{
  "name": "paulibaby-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -b",
    "test:worker": "tsc -p tsconfig.tests.json --noEmit false --rewriteRelativeImportExtensions --outDir .wrangler/worker-tests && node --test .wrangler/worker-tests/tests/worker/*.test.js",
    "test:frontend": "tsc -p tsconfig.tests.json --noEmit false --rewriteRelativeImportExtensions --outDir .wrangler/test-run && node --test .wrangler/test-run/tests/frontend/*.test.js",
    "test:ui": "vitest run --config tests/frontend/vitest.config.ts",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@cloudflare/containers": "0.0.25",
    "@fluentui/react": "8.125.10",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-table": "3.35.0",
    "@tiptap/extension-text-align": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "jose": "6.2.18",
    "jspdf": "4.2.1",
    "lucide-react": "^1.76.0",
    "prettier": "3.10.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.2.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "6.18.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.23.0",
    "turndown": "7.2.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@eslint/js": "9.39.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.3.8",
    "vitest": "3.2.4",
    "wrangler": "4.136.1"
  }
}
