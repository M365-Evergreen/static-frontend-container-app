{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paulibaby-agent",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "e33c33ce-55ad-49b4-8d89-02e1718d1d03"
      }
    ]
  },
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "paulibaby.cloudflareaccess.com",
    "CF_ACCESS_AUDIENCE": "3cca06c718eeae1d5f9104416620e620e64b0772bc9de4b732f4799e472f3603",
    "KNOWLEDGE_MCP_URL": "https://9904ca51-56e6-48cd-ae7e-3e0f154d2724.search.ai.cloudflare.com/mcp",
    "LLM_MODEL": "gemini-3.8-flash",
    "LLM_PROVIDER": "gemini"
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "containers": [
    {
      "class_name": "AgentContainer",
      "image": "./container/Dockerfile",
      "image_build_context": ".",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_CONTAINER",
        "class_name": "PaulibabyAgent",
        "script_name": "agent-paulibaby",
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "e33c33ce-55ad-49b4-8d89-02e1718d1d03",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "paulibaby-agent"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AgentContainer"
      ]
    }
  ]
}
