{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paulibaby-agent",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENTRA_API_AUDIENCE": "7ea67f3b-a85c-4427-855a-578c168edc27",
    "ENTRA_API_SCOPE": "api://7ea67f3b-a85c-4427-855a-578c168edc27/Chat.Access",
    "ENTRA_CLIENT_ID": "7ea67f3b-a85c-4427-855a-578c168edc27",
    "ENTRA_TENANT_ID": "7a5bf294-6ae8-47c4-b0c4-b2f9166d7a3f",
    "KNOWLEDGE_MCP_URL": "https://9904ca51-56e6-48cd-ae7e-3e0f154d2724.search.ai.cloudflare.com/mcp",
    "LLM_API_KEY": "AQ.Ab8RN6KbXddMt_aNlEGy8YivBfvddQLFEEhVkyb1Re4w_6BTYw",
    "LLM_MODEL": "gemini-3.8-flash",
    "LLM_PROVIDER": "gemini"
  },

  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "containers": [
    {
      "class_name": "AgentContainer",
      "image": "./container/Dockerfile",
      "image_build_context": ".",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_CONTAINER",
        "class_name": "AgentContainer"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "e33c33ce-55ad-49b4-8d89-02e1718d1d03",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "paulibaby-agent"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AgentContainer"
      ]
    }
  ]
}