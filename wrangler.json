{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paulibaby-agent",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": { "enabled": true },
  "vars": {
    "LLM_PROVIDER": "google",
    "LLM_MODEL": "gemini-3.8-flash"
  },
  "secrets": {
    "required": [
      "LLM_API_KEY"
    ]
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "containers": [
    {
      "class_name": "AgentContainer",
      "image": "./container/Dockerfile",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_CONTAINER",
        "class_name": "AgentContainer"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "e33c33ce-55ad-49b4-8d89-02e1718d1d03"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "paulibaby-agent"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AgentContainer"
      ]
    }
  ]
}